# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Your Shopify store subdomain (e.g. my-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token (public — safe to expose in the browser)
# Shopify Admin → Apps → Develop apps → Create app →
#   Configure Storefront API scopes → enable unauthenticated_read_products
#   → Install app → copy "Storefront API access token"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token

# ─── Shopify Product Metafields ───────────────────────────────────────────────
# Set these up in Shopify Admin → Content → Metafields → Products
# Namespace: custom
# Keys used by the website:
#   dimensions        → text (e.g. "18\" x 10\" x 1.25\"")
#   care_instructions → text (e.g. "Hand wash only. Oil monthly.")
#   materials         → text (e.g. "Black walnut, food-safe mineral oil")
#   weight_text       → text (e.g. "2.4 lbs")
#   lead_time         → text (e.g. "3–4 weeks")
#
# Tag conventions on products:
#   Wood type: add a tag matching the wood name, e.g. "Walnut", "Oak", "Maple"
#   Size:      add a tag "Small", "Medium", or "Large"
#   Item type: set the Product Type field in Shopify (e.g. "Tables", "Cabinets", "Small Goods")

# ─── SMTP (Contact Form) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# Email recipient for contact form submissions
CONTACT_TO_EMAIL=thehaymarketwoodshop@gmail.com

# Site URL (for Open Graph tags)
NEXT_PUBLIC_SITE_URL=https://haymarketwoodshop.com

# ─── Supabase (server-only, admin invoicing) ──────────────────────────────────
# Supabase Dashboard → Project Settings → API → "service_role" secret key.
# NEVER prefix this with NEXT_PUBLIC_ — it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Shopify Admin API (server-only, invoice payments via Draft Orders) ───────
# Different from the Storefront token above — this needs a Dev Dashboard app with
# write_draft_orders + read_draft_orders + read_orders scopes, installed on this store.
# Shopify apps no longer expose a static Admin API token in the UI — the app's
# client_id/client_secret are exchanged for a short-lived access token at request time
# (see src/lib/shopify.ts), so both must be set here.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-app-client-id
SHOPIFY_CLIENT_SECRET=your-app-client-secret

# After deploying, register an orders/paid webhook pointing at
# https://yourdomain.com/api/shopify/webhook and paste its signing secret here.
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-secret

# Email recipient for invoice signed/paid notifications (falls back to
# CONTACT_TO_EMAIL above if unset).
INVOICE_ADMIN_EMAIL=thehaymarketwoodshop@gmail.com
